{
  "name": "@0xobelisk/merak-sdk",
  "version": "0.0.59",
  "description": "Tookit for interacting with merak protocol",
  "keywords": [
    "sui",
    "merak",
    "obelisk labs",
    "move",
    "blockchain"
  ],
  "author": "team@obelisk.build",
  "homepage": "https://github.com/0xobelisk/merak-sdk",
  "bugs": "https://github.com/0xobelisk/merak-sdk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xobelisk/merak-sdk.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
    "build": "npm run build:types && npm run build:tsup",
    "build:tsup": "tsup ./src/index.ts --format esm,cjs --sourcemap",
    "build:types": "tsc --build",
    "watch:tsup": "tsup ./src/index.ts --format esm,cjs --clean --splitting --watch",
    "watch:types": "tsc --watch",
    "watch": "pnpm run clean & pnpm run watch:types & pnpm run watch:tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:wrapper": "vitest run tests/integration/wrapper.test.ts",
    "test:assets": "vitest run tests/integration/assets.test.ts",
    "test:dex": "vitest run tests/integration/dex.test.ts",
    "test:e2e": "vitest run tests/e2e",
    "legacy:test:all": "ts-node -r tsconfig-paths/register scripts/test-all-methods.ts",
    "legacy:test:quick": "ts-node -r tsconfig-paths/register scripts/quick-test.ts",
    "legacy:test:fields": "ts-node -r tsconfig-paths/register scripts/verify-graphql-fields.ts",
    "legacy:test:storage": "ts-node -r tsconfig-paths/register scripts/test-storage-queries.ts",
    "legacy:test:wrapper": "ts-node -r tsconfig-paths/register scripts/test-wrapper-complete.ts",
    "legacy:test:dex": "ts-node -r tsconfig-paths/register scripts/test-dex-complete.ts",
    "legacy:test:assets": "ts-node -r tsconfig-paths/register scripts/test-assets-complete.ts",
    "legacy:test:e2e": "ts-node -r tsconfig-paths/register scripts/test-swap-e2e.ts",
    "legacy:test:integration": "ts-node -r tsconfig-paths/register scripts/test-integration.ts",
    "legacy:test:latency": "ts-node -r tsconfig-paths/register scripts/test-query-latency.ts",
    "format:fix": "prettier --ignore-path 'dist/* docs/*' --write '**/*.{ts,json,md}'",
    "lint:fix": "eslint . --ignore-pattern dist --ext .ts --fix",
    "commit": "commit",
    "doc": "typedoc --out docs src/index.ts",
    "chalk": "^5.0.1",
    "prettier": "^2.8.4",
    "prettier-plugin-rust": "^0.1.9"
  },
  "dependencies": {
    "@0xobelisk/ecs": "1.2.0-pre.83",
    "@0xobelisk/graphql-client": "1.2.0-pre.83",
    "@0xobelisk/sui-cli": "1.2.0-pre.83",
    "@0xobelisk/sui-client": "1.2.0-pre.83",
    "@0xobelisk/sui-common": "1.2.0-pre.83",
    "@mysten/sui": "1.19.0",
    "assert": "^2.1.0",
    "bech32": "^2.0.0",
    "colorts": "^0.1.63",
    "husky": "^8.0.3",
    "keccak256": "^1.0.6",
    "process": "^0.11.10",
    "superstruct": "^1.0.4",
    "tmp": "^0.2.3",
    "ts-retry-promise": "^0.7.1",
    "tweetnacl": "^1.0.3",
    "valibot": "0.36.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@commitlint/prompt-cli": "^18.6.1",
    "@types/node": "^20.17.46",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/ui": "^2.1.8",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.4.0",
    "lint-staged": "^15.5.2",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^7.2.0",
    "typedoc": "^0.25.13",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
